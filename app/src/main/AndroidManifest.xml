<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Oscarapp">

        <activity
            android:name=".view.LoginActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".view.BoasVindasActivity"
            android:exported="false" />

        <activity
            android:name=".view.VotarFilmeActivity"
            android:exported="false"
            android:label="@string/titulo_votar_filme" />

        <activity
            android:name=".view.DetalheFilmeActivity"
            android:exported="false"
            android:label="@string/titulo_detalhe_filme" />

        <activity
            android:name=".view.VotarDiretorActivity"
            android:exported="false"
            android:label="@string/titulo_votar_diretor" />

        <activity
            android:name=".view.ConfirmarVotoActivity"
            android:exported="false"
            android:label="@string/titulo_confirmar_voto" />

    </application>

</manifest>
