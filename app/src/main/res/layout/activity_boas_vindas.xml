<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSaudacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/oscar_ink"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Bem-vindo(a), Bob!"
            xmlns:tools="http://schemas.android.com/tools" />

        <ImageView
            android:layout_width="160dp"
            android:layout_height="240dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/oscar_trophy_desc"
            android:src="@drawable/ic_oscar_trophy" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bv_token_label"
                    android:textColor="@color/oscar_gray"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvToken"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/oscar_gold_dark"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    tools:text="42"
                    xmlns:tools="http://schemas.android.com/tools" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvVotoRegistrado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/oscar_success_bg"
            android:padding="16dp"
            android:textColor="@color/oscar_success"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="✓ Seu voto já foi registrado e não pode ser alterado."
            tools:visibility="visible"
            xmlns:tools="http://schemas.android.com/tools" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVotarFilme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/bv_votar_filme"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVotarDiretor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/bv_votar_diretor"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarVoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/bv_confirmar_voto"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSair"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/bv_sair" />
    </LinearLayout>
</ScrollView>
